# Telegram
TENDURA_TELEGRAM_TOKEN=
TENDURA_ALLOWED_TELEGRAM_ID=

# Training Endurance
# Не указывайте пароль Google. Значение будет получено отдельным безопасным
# способом после проверки механизма долгоживущей сессии.
TENDURA_TRAINING_ENDURANCE_SESSION=
TENDURA_TRAINING_ENDURANCE_COOKIE=
TENDURA_TRAINING_ENDURANCE_USER_ID=

# COROS
# Файл создаётся отдельным OAuth-подключением и должен иметь права 600.
TENDURA_COROS_OAUTH_FILE=data/coros-oauth.json

# Runtime
TENDURA_TIMEZONE=Europe/Moscow
TENDURA_NOTIFICATION_TIME=07:00
TENDURA_STATE_DB=data/tendura.sqlite3
