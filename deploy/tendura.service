[Unit]
Description=Tendura Telegram bot
After=network-online.target
Wants=network-online.target
Requires=xray-tendura.service
After=xray-tendura.service

[Service]
Type=simple
WorkingDirectory=/opt/tendura
EnvironmentFile=/etc/tendura/tendura.env
ExecStart=/opt/tendura/.venv/bin/python -m tendura
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
